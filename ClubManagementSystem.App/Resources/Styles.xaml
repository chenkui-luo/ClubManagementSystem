<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 全局卡片样式 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="1" Opacity="0.1" BlurRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页面标题样式 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1A1A2E" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!-- 统一的表单 TextBox 样式 -->
    <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,2,0,12" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 统一的表单 ComboBox 样式 -->
    <Style x:Key="FormComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,2,0,12" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- 主按钮样式 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="5,0" />
    </Style>

    <!-- 卡片内标题 -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#333" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

</ResourceDictionary>
