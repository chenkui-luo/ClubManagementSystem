<mah:MetroWindow x:Class="ClubManagementSystem.App.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="注册新账号"
        Height="580" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <Grid Background="#F5F6FA">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="12" Width="360"
                    Margin="30,0" Padding="35,25">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.15" BlurRadius="20" />
                </Border.Effect>

            <StackPanel>
                <TextBlock Text="注册新账号" FontSize="22" FontWeight="Bold"
                           Foreground="#1A73E8" HorizontalAlignment="Center"
                           Margin="0,0,0,25" />

                <TextBlock Text="学号" FontSize="13" Foreground="#555" Margin="0,0,0,3" />
                <TextBox x:Name="TxtStudentId" mah:TextBoxHelper.Watermark="请输入学号"
                         Style="{StaticResource FormTextBoxStyle}" />

                <TextBlock Text="姓名" FontSize="13" Foreground="#555" Margin="0,8,0,3" />
                <TextBox x:Name="TxtName" mah:TextBoxHelper.Watermark="请输入姓名"
                         Style="{StaticResource FormTextBoxStyle}" />

                <TextBlock Text="密码" FontSize="13" Foreground="#555" Margin="0,8,0,3" />
                <PasswordBox x:Name="TxtPassword" mah:TextBoxHelper.Watermark="请输入密码"
                             Style="{StaticResource MahApps.Styles.PasswordBox}"
                             Height="36" FontSize="14" />

                <TextBlock Text="确认密码" FontSize="13" Foreground="#555" Margin="0,8,0,3" />
                <PasswordBox x:Name="TxtConfirmPwd" mah:TextBoxHelper.Watermark="请再次输入密码"
                             Style="{StaticResource MahApps.Styles.PasswordBox}"
                             Height="36" FontSize="14" />

                <TextBlock Text="手机号" FontSize="13" Foreground="#555" Margin="0,8,0,3" />
                <TextBox x:Name="TxtPhone" mah:TextBoxHelper.Watermark="选填"
                         Style="{StaticResource FormTextBoxStyle}" />

                <TextBlock x:Name="TxtError" Foreground="#E74C3C" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />

                <Button Content="注  册" Height="42" FontSize="15" FontWeight="SemiBold"
                        Background="#1A73E8" Foreground="White"
                        Margin="0,15,0,0"
                        Click="RegisterButton_Click" />
            </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</mah:MetroWindow>
